/.vs/
/.vscode/
/.idea/

# Anatomia recognizes simple directory entries when pruning generated sources.
build/
build-revisor/
/build-*/
/out/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake

# Anatomia's production graph prunes this bare directory name. The negation
# re-includes the directory for git, so test sources stay versioned and
# available to CMake. Do not add `!tests/**` here: it would also win over the
# `build/` rule above and start tracking build output under tests/.
tests/
!tests/

# Anatomia のローカル状態は commit しない。ドメイン定義の正本は spec/domains/。
/.anatomia/

/data/generated/
/data/cache/
/logs/

*.user
*.suo
*.VC.db
*.VC.opendb
*.pdb
*.obj
*.ilk
*.exe
*.dll
*.lib

# Native mobile build output
/mobile/android/.gradle/
/mobile/android/.idea/
/mobile/android/local.properties
/mobile/android/app/.cxx/
/mobile/android/app/build/
/build-mobile-assets/

.DS_Store
Thumbs.db
