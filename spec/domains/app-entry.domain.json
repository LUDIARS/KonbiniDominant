{
  "name": "app-entry",
  "description": "実行体の入口。デスクトップ／モバイル共通セッション、カメラ、HUD、pointer intent、playtest automation、資産ステージと配布検証を所有する。",
  "presetRules": [],
  "templateRules": [],
  "membership": [
    {
      "pathPattern": "(^|/)src/app/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)include/(?:.*/)?app/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)src/[^/]+$"
    },
    {
      "pathPattern": "(^|/)tests?/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)third_party/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)cmake/(StageRuntimeAssets|WriteGitRevision)\\.cmake$"
    },
    {
      "pathPattern": "(^|/)tools/(package_.*|playtest_.*|run_native_playtest|pe_dependencies)\\.py$"
    }
  ]
}
