{
  "name": "platform-adapters",
  "description": "外部との接続。Pictor／Ergo／Figmentumと、Windows touch・Android NativeActivity・iOS UIKit/CAMetalLayer (Metal直描画、2026-10-03決定) の差を吸収する。",
  "presetRules": [],
  "templateRules": [],
  "membership": [
    {
      "pathPattern": "^CMakeLists\\.txt$"
    },
    {
      "pathPattern": "(^|/)src/adapters/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)include/(?:.*/)?adapters/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)mobile/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)cmake/(MobileVulkan|mobile/FindVulkan|RequireErgoRealRender|VerifyExactGitSource)\\.cmake$"
    },
    {
      "pathPattern": "(^|/)web/[^/]+.(?:cpp|h|js)$"
    }
  ],
  "specRefs": [
    "spec/ux/product.md",
    "spec/design.md",
    "spec/interface/ergo-runtime.md",
    "spec/interface/mobile-platform.md",
    "spec/interface/pictor-rendering.md",
    "spec/setup/native-development.md",
    "spec/feature/web-pictor.md",
    "spec/interface/figmentum-city-generation.md",
    "spec/setup/mobile-development.md",
    "spec/setup/macos-development.md"
  ]
}
