{
  "name": "platform-adapters",
  "description": "外部との接続。Pictor／Ergo／Figmentumと、Windows touch・Android NativeActivity・iOS UIKit/Vulkan surfaceの差を吸収する。",
  "presetRules": [],
  "templateRules": [],
  "membership": [
    {
      "pathPattern": "(^|/)src/adapters/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)include/(?:.*/)?adapters/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)mobile/(?:.*/)?[^/]+$"
    },
    {
      "pathPattern": "(^|/)cmake/(MobileVulkan|mobile/FindVulkan)\\.cmake$"
    },
    {
      "pathPattern": "(^|/)web/[^/]+.(?:cpp|h|js)$"
    }
  ],
  "specRefs": [
    "spec/ux/product.md",
    "spec/design.md",
    "spec/interface/ergo-runtime.md",
    "spec/interface/mobile-platform.md",
    "spec/interface/pictor-rendering.md",
    "spec/feature/web-pictor.md"
  ]
}
